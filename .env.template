# ============================================================
#  .env — Your secret keys. NEVER commit this to git.
#  Copy this file: cp .env.template .env
#  Then fill in each value below.
# ============================================================

# ── OpenRouter Provisioning Key ──────────────────────────────
# This is NOT a regular API key. It's a special key that lets
# you create/manage per-user keys programmatically.
#
# How to get it:
#   1. Create an account at openrouter.ai
#   2. Add funds to your account (you resell these credits)
#   3. Go to: openrouter.ai/settings/provisioning-keys
#   4. Click "Create New Key"
#   5. Paste it here
#
# This single key controls all your users' credit limits.
OPENROUTER_PROVISIONING_KEY=sk-or-v1-YOUR_PROVISIONING_KEY_HERE

# ── Admin Dashboard ──────────────────────────────────────────
# Password to access the admin dashboard at /admin/
# Change this to a strong random password before deploying!
ADMIN_PASSWORD=changeme

# ── Alert Notifications (optional) ──────────────────────────
# Telegram bot + chat ID for automated alerts (health checks,
# billing alerts, daily reports). Create a bot via @BotFather.
# Leave blank to disable Telegram alerts.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ── Telegram Bot Tokens ──────────────────────────────────────
# One token per user. Get them from @BotFather on Telegram:
#   1. Message @BotFather
#   2. Send /newbot
#   3. Pick a name (e.g. "Sarah's Assistant")
#   4. Copy the token it gives you
#
# These are set by add-claw.sh automatically — but docker-compose
# also reads them here if you prefer to use compose directly.
ALICE_BOT_TOKEN=
BOB_BOT_TOKEN=
CAROL_BOT_TOKEN=
# Add more as needed: DAVE_BOT_TOKEN= etc.

# ── Per-user OpenRouter Keys ─────────────────────────────────
# These are created automatically by add-claw.sh.
# You don't need to fill these in manually —
# add-claw.sh creates the key and writes it here.
# (listed for reference / if you want to override)
ALICE_OPENROUTER_KEY=
BOB_OPENROUTER_KEY=
CAROL_OPENROUTER_KEY=

# ── Optional ─────────────────────────────────────────────────
DOMAIN=yourdomain.com
